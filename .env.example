# Copiez ce fichier en .env et renseignez chaque valeur.
# Aucune valeur de ce fichier n'est un secret de repli : ce sont des exemples
# de forme. Le site refuse de démarrer en production si un secret manque,
# plutôt que de tourner avec une valeur connue de tous.

# --- Base de données ---------------------------------------------------------
# Postgres. La variable s'appelle DATABASE_URI, et non DATABASE_URL.
DATABASE_URI="postgresql://127.0.0.1:5432/cot27"

# --- Payload CMS -------------------------------------------------------------
# OBLIGATOIRE en production : ce secret signe les jetons de session de
# l'administration. Qui le connaît peut forger une session administrateur et
# exporter le fichier complet des inscrits. Générez-le avec :
#   openssl rand -base64 32
PAYLOAD_SECRET=""

# --- Paiement FedaPay --------------------------------------------------------
# Sans FEDAPAY_SECRET_KEY, le site tourne en mode démo : les inscriptions sont
# enregistrées en paiement sur place et aucun débit n'est possible.
FEDAPAY_SECRET_KEY=""
FEDAPAY_ENV="sandbox"          # "live" pour les paiements réels

# OBLIGATOIRE dès que FEDAPAY_SECRET_KEY est renseignée. Sans elle, aucune
# notification de paiement ne peut être authentifiée : elles sont toutes
# refusées et les inscriptions resteraient indéfiniment « en attente ».
# Valeur fournie par le tableau de bord FedaPay.
FEDAPAY_WEBHOOK_SECRET=""

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
