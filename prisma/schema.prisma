generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Registration {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  email         String
  phone         String
  club          String?
  city          String?
  country       String   @default("Bénin")
  memberType    String // "member" | "guest"
  ticketType    String // key from tickets catalog
  amount        Int // FCFA
  currency      String   @default("XOF")
  status        String   @default("PENDING") // PENDING | PAID | ONSITE | CANCELLED
  paymentMethod String   @default("onsite") // "fedapay" | "onsite"
  paymentRef    String? // FedaPay transaction id
  locale        String   @default("fr")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
